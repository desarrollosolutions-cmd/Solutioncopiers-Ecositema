{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "bash build.sh"
  },
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && gunicorn solution_copiers.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --threads 4 --timeout 60 --preload"
  }
}
