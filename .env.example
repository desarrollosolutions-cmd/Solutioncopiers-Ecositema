# =============================================================================
# .env.example — Plantilla de variables de entorno
# COPIAR A .env Y RELLENAR CON VALORES REALES (.env NO se commitea NUNCA)
# IMPORTANTE: Este archivo NO debe contener credenciales reales.
# =============================================================================

# === Django Core ===
DJANGO_SETTINGS_MODULE=solution_copiers.settings.development
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-real-secret-key-never-commit
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === Base de datos ===
# Formato: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/solution_copiers_db

# === Email ===
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Solution Copiers <no-reply@solutioncopiers.com>
LEADS_NOTIFICATION_EMAIL=ventas@solutioncopiers.com

# === SEO y dominio ===
SITE_DOMAIN=localhost:8000
SITE_NAME=Solution Copiers
SITE_PROTOCOL=http

# === Sentry (vacío en desarrollo) ===
SENTRY_DSN=

# === Google (opcional) ===
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=

# === WhatsApp Notificaciones (CallMeBot) ===
CALLMEBOT_APIKEY=
WHATSAPP_NOTIFY_PHONE=+57

# === IA — Asistente virtual ===
# OPCIÓN GRATIS — Groq: regístrate en https://console.groq.com, crea una API Key y pégala aquí
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY
# OPCIÓN PAGO — Anthropic Claude
ANTHROPIC_API_KEY=

# === Cloudflare R2 — Almacenamiento de imágenes (producción) ===
R2_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key
R2_BUCKET_NAME=solution-copiers-media
R2_CUSTOM_DOMAIN=

# === Wompi — Pasarela de pagos Colombia ===
# Claves de PRUEBA (sandbox): https://comercios.wompi.co
WOMPI_PUBLIC_KEY=pub_test_REPLACE_WITH_YOUR_KEY
WOMPI_PRIVATE_KEY=prv_test_REPLACE_WITH_YOUR_KEY
WOMPI_INTEGRITY_KEY=test_integrity_REPLACE_WITH_YOUR_KEY
WOMPI_EVENTS_KEY=test_events_REPLACE_WITH_YOUR_KEY
