{
  "name": "solution-copiers-frontend",
  "version": "1.0.0",
  "description": "Frontend build pipeline for Solution Copiers",
  "private": true,
  "scripts": {
    "dev:css": "tailwindcss -i ./static/src/css/input.css -o ./static/dist/css/main.css --watch",
    "build:css": "tailwindcss -i ./static/src/css/input.css -o ./static/dist/css/main.css --minify",
    "dev:js": "node esbuild.config.mjs --watch",
    "build:js": "node esbuild.config.mjs --production",
    "dev": "npm-run-all --parallel dev:css dev:js",
    "build": "npm-run-all build:css build:js"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "alpinejs": "^3.14.7",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20"
  }
}
